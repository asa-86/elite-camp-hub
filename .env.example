# Public browser settings. The publishable/anon key is safe only when RLS is enabled.
VITE_DATA_MODE=demo
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SITE_URL=https://your-production-domain.example
VITE_FILE_SERVICE_URL=https://files.your-domain.example
VITE_FILE_MAX_MB=20

# Server-only secrets. Never prefix these with VITE_ or expose them to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-in-server-secret-store
SUPABASE_ANON_KEY=your-supabase-anon-key
FILE_SERVICE_API_TOKEN=replace-in-server-secret-store
